// Random numbers: 512 generators of white noise, each feeding pink and
// brown filters. Every copy has its own sequence, so this is the cost of
// `noise()` itself and of the state around it.

import @gen/noise

const N = 512

rill colours() Sample {
    return noise() * 0.2 + pink() + brown()
}

rill main() [Sample; 2] {
    let x = sum([colours(); N]) / N
    return [x, x]
}
