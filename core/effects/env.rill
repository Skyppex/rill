// Envelopes: levels that move over time, driven by a gate or by a signal.
//
// A gate is a `Float` above 0 while a note is held. A voice sets it in its
// handlers (`gate = 1` on a note-on, `0` on its note-off), so an envelope
// works the same for a sequence, a key or an LFO.
//
// Times are how long a move takes to get 99.9% of the way (60 dB), as with
// analog envelopes, which move fast at first and slow down near the end.

// The per-sample step toward a target that gets 99.9% of the way there in
// `time`.
fn step(time: Time) Float {
    1 - exp(log(0.001) / max(time * RATE, 1))
}

// Follows `x`, taking `rise` to move up and `fall` to move down. With both
// the same it smooths a knob or a step into a glide; on `abs(x)` with a
// short rise and a long fall it follows the level of a signal; with a fall
// of 0 it holds peaks. A one-pole lowpass, with a time instead of a cutoff.
export rill slew(x: Float, rise: Time = 20ms, fall: Time = 20ms) Float {
    state y: Float = 0
    let time = if x > y { rise } else { fall }
    y = y + (x - y) * step(time)
    return y
}

// Attack, hold, decay, sustain, release, from 0 to 1. When `gate` opens it
// rises to 1 in `attack`, stays at 1 for `hold`, then falls toward
// `sustain` over `decay` while the gate is held, and falls to 0 over
// `release` once it closes. Opening the gate again starts a new attack from
// wherever the level is.
//
// With `hold` 0 it is an ADSR; with `sustain` 1, an attack-release; with
// `sustain` 0, a one-shot that is gone after its decay, whatever the gate
// does.
export rill ahdsr(
    gate: Float,
    attack: Time = 10ms,
    hold: Time = 0s,
    decay: Time = 100ms,
    sustain: Float = 0.7,
    release: Time = 300ms,
) Float {
    state level: Float = 0
    state attacking: Bool = false
    // Samples of the hold still to go.
    state holding: Float = 0
    state last: Float = 0
    let held = gate > 0

    if held && last <= 0 {
        attacking = true
        holding = 0
    }

    last = gate

    if !held {
        attacking = false
        holding = 0
    }

    // The attack aims past 1 and stops there, so it is quick at the top
    // like an analog one: from 0 it reaches 1 in `attack`.
    let target = if attacking {
        1.2
    } else if holding > 0 {
        1.0
    } else if held {
        sustain
    } else {
        0.0
    }

    let rate = if attacking {
        1 - exp(-log(6) / max(attack * RATE, 1))
    } else if holding > 0 {
        1.0
    } else if held {
        step(decay)
    } else {
        step(release)
    }

    level = level + (target - level) * rate
    holding = max(holding - 1, 0)

    if attacking && level >= 1 {
        level = 1
        attacking = false
        holding = hold * RATE
    }

    return level
}
