// Filters with any slope, all built from state-variable stages (Zavalishin's
// and Simper's trapezoidal form), which stay stable however fast `cutoff`,
// `resonance` and `slope` move.
//
// - `cutoff` is kept between 1Hz and just below half the sample rate.
// - `resonance` goes from 0 (no peak) to 1 (a sharp peak that rings).
// - `slope` is how steeply the filter falls, as in `24dB / 1oct`: each 6 dB
//   per octave is one pole. It is a stream: a slope between whole poles
//   blends the two nearest, so it can move smoothly.
// - `max` is the steepest a moving `slope` will be. The stages for it are
//   built before audio starts, and they all run. A constant `slope` is its
//   own steepest. A live program that finds `slope` going past `max` is
//   rebuilt with room for more.
//
// The default slope, 12 dB per octave, is one state-variable stage.

// One pole: 6 dB per octave.
const POLE: Slope = 6dB / 1oct

// Two poles: `[lowpass, bandpass, highpass]`. `k` is the damping: √2 is
// flat, near 0 rings.
rill svf(x: Sample, cutoff: Freq, k: Float) [Sample; 3] {
    state ic1: Float = 0
    state ic2: Float = 0
    let g = tan(PI * clamp(cutoff, 1Hz, RATE * 0.49) / RATE)
    let a1 = 1 / (1 + g * (g + k))
    let a2 = g * a1
    let a3 = g * a2
    let v3 = x - ic2
    let v1 = a1 * ic1 + a2 * v3
    let v2 = ic2 + a2 * ic1 + a3 * v3
    ic1 = 2 * v1 - ic1
    ic2 = 2 * v2 - ic2
    return [v2, v1, x - k * v1 - v2]
}

// One pole: `[lowpass, highpass]`.
rill one_pole(x: Sample, cutoff: Freq) [Sample; 2] {
    state s: Float = 0
    let g = tan(PI * clamp(cutoff, 1Hz, RATE * 0.49) / RATE)
    let v = (x - s) * g / (1 + g)
    let low = v + s
    s = low + v
    return [low, x - low]
}

// The damping of the first stage, which carries the resonance.
fn damping(resonance: Float) Float {
    sqrt(2.0) - (sqrt(2.0) - 0.01) * clamp(resonance, 0, 1)
}

// Pairs of poles, with a pole after each pair for the odd counts; the output
// at `slope` blends the two nearest counts. `high` picks the highpass side.
rill pairs(
    x: Sample,
    cutoff: Freq,
    resonance: Float,
    slope: Slope,
    steepest: Slope,
    high: Bool,
) Sample {
    // How many poles to build: as many as `slope` asks for if it is a
    // constant; if it moves, as many as `steepest` (and more if a live
    // program finds it going further).
    let most = ceil(ceiling(abs(slope / POLE), abs(steepest / POLE)))

    let p = clamp(abs(slope / POLE), 0, most)
    let lo = floor(p)
    let blend = p - lo
    let below = x
    let above = x
    let y = x

    for j in 0..(ceil(most / 2) as Int) {
        let before = (j * 2) as Float

        let k = if j == 0 {
            damping(resonance)
        } else {
            sqrt(2.0)
        }

        let two = svf(y, cutoff, k)
        let one = one_pole(y, cutoff)

        let odd = if high {
            one[1]
        } else {
            one[0]
        }

        let even = if high {
            two[2]
        } else {
            two[0]
        }

        below = if lo == before + 1 {
            odd
        } else if lo == before + 2 {
            even
        } else {
            below
        }

        above = if lo + 1 == before + 1 {
            odd
        } else if lo + 1 == before + 2 {
            even
        } else {
            above
        }

        y = even
    }

    return below + (above - below) * blend
}

// Bandpass stages, each falling 6 dB per octave on both sides, with the peak
// at 0 dB; the output at `slope` blends the two nearest counts.
rill bands(
    x: Sample,
    cutoff: Freq,
    resonance: Float,
    slope: Slope,
    steepest: Slope,
) Sample {
    // How many poles to build: as many as `slope` asks for if it is a
    // constant; if it moves, as many as `steepest` (and more if a live
    // program finds it going further).
    let most = ceil(ceiling(abs(slope / POLE), abs(steepest / POLE)))

    let p = clamp(abs(slope / POLE), 0, most)
    let lo = floor(p)
    let blend = p - lo
    let below = x
    let above = x
    let y = x

    for j in 0..(most as Int) {
        let before = j as Float

        let k = if j == 0 {
            damping(resonance)
        } else {
            sqrt(2.0)
        }

        let band = svf(y, cutoff, k)[1] * k

        below = if lo == before + 1 {
            band
        } else {
            below
        }

        above = if lo + 1 == before + 1 {
            band
        } else {
            above
        }

        y = band
    }

    return below + (above - below) * blend
}

// Passes what is below `cutoff`, falling `slope` above it.
export rill lowpass(
    x: Sample,
    cutoff: Freq,
    resonance: Float = 0,
    slope: Slope = 12dB / 1oct,
    max: Slope = 48dB / 1oct,
) Sample {
    return pairs(x, cutoff, resonance, slope, max, false)
}

// Passes what is above `cutoff`, falling `slope` below it. At 10Hz it
// removes a constant offset.
export rill highpass(
    x: Sample,
    cutoff: Freq,
    resonance: Float = 0,
    slope: Slope = 12dB / 1oct,
    max: Slope = 48dB / 1oct,
) Sample {
    return pairs(x, cutoff, resonance, slope, max, true)
}

// Passes what is near `cutoff`, falling `slope` on each side; more
// resonance narrows the peak.
export rill bandpass(
    x: Sample,
    cutoff: Freq,
    resonance: Float = 0,
    slope: Slope = 6dB / 1oct,
    max: Slope = 48dB / 1oct,
) Sample {
    return bands(x, cutoff, resonance, slope, max)
}

// Removes what is near `cutoff`: the input less the bandpass, so `slope`
// makes the notch steeper and resonance narrows it.
export rill notch(
    x: Sample,
    cutoff: Freq,
    resonance: Float = 0,
    slope: Slope = 6dB / 1oct,
    max: Slope = 48dB / 1oct,
) Sample {
    return x - bands(x, cutoff, resonance, slope, max)
}

// Passes everything at the same level and moves only the phase: a quarter
// turn per pole at `cutoff`, less below it and more above. Several poles
// swept together and mixed with the dry sound make a phaser; `resonance`
// makes the first pair turn more sharply. `poles` must be constant.
export rill allpass(
    x: Sample,
    cutoff: Freq,
    resonance: Float = 0,
    poles: Int = 1,
) Sample {
    let y = x

    for j in 0..(poles / 2) {
        let k = if j == 0 {
            damping(resonance)
        } else {
            sqrt(2.0)
        }

        let s = svf(y, cutoff, k)
        y = y - 2 * k * s[1]
    }

    let one = one_pole(y, cutoff)

    return if poles % 2 == 1 {
        one[0] - one[1]
    } else {
        y
    }
}

// One section of `hilbert`: a second-order allpass in two-sample steps, `a`
// its coefficient.
rill allpass_z2(x: Sample, a: Float) Sample {
    state x1: Sample = 0
    state x2: Sample = 0
    state y1: Sample = 0
    state y2: Sample = 0
    let y = a * a * (x + y2) - x2
    x2 = x1
    x1 = x
    y2 = y1
    y1 = y
    return y
}

// `x` as a pair `[i, q]` a quarter turn apart at every frequency: `q` is
// `i` turned back by 90°, so a cosine gives a sine. The basis of frequency
// shifting and single-sideband modulation. Two chains of allpasses (Olli
// Niemitalo's design), within a degree of 90° from 30Hz to 15kHz; both come
// out a little late.
export rill hilbert(x: Sample) [Sample; 2] {
    state late: Sample = 0

    let a = x
        |> allpass_z2(0.6923878)
        |> allpass_z2(0.9360654322959)
        |> allpass_z2(0.9882295226860)
        |> allpass_z2(0.9987488452737)

    let b = x
        |> allpass_z2(0.4021921162426)
        |> allpass_z2(0.8561710882420)
        |> allpass_z2(0.9722909545651)
        |> allpass_z2(0.9952884791278)

    let i = late
    late = a
    return [i, -b]
}
