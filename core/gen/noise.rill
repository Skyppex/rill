// Noise colours. White noise is `noise()` from the prelude: equal energy at
// every frequency, a hiss. These take energy away from the top.

// Pink noise: 3 dB less per octave, so every octave has the same energy;
// a rain-like sound. Paul Kellet's three-pole approximation.
export rill pink() Sample {
    state b0: Float = 0
    state b1: Float = 0
    state b2: Float = 0
    let w = noise()
    b0 = 0.99765 * b0 + w * 0.099046
    b1 = 0.963 * b1 + w * 0.2965164
    b2 = 0.57 * b2 + w * 1.0526913
    return (b0 + b1 + b2 + w * 0.1848) * 0.12
}

// Brown noise: 6 dB less per octave; a low rumble. White noise summed up,
// leaking slowly back toward 0 so it never drifts away.
export rill brown() Sample {
    state y: Float = 0
    y = (y + noise() * 0.02) / 1.02
    return y * 3.5
}

// Perlin noise: a value that wanders smoothly at random between 0 and 1,
// turning about `rate` times a second. Good for slow, natural movement:
// `200Hz + perlin(0.3Hz) * 800Hz`, or a drift in pitch or pan.
//
// At every whole step it picks a new random slope; between two steps, the
// lines through each step's slope are blended with Perlin's fade
// (6t⁵ - 15t⁴ + 10t³), which leaves no corners. It passes through 0.5 at
// every step.
export rill perlin(rate: Freq) Float {
    state t: Float = 0
    // The slopes at the step behind and the step ahead.
    state behind: Float = random() * 2 - 1
    state ahead: Float = random() * 2 - 1
    // Drawn every sample, so copies can run together; kept only at a step.
    let next = noise()
    let fade = t * t * t * (t * (t * 6 - 15) + 10)
    let from = behind * t
    let to = ahead * (t - 1)
    // From -0.5 to 0.5 around the middle.
    let out = from + (to - from) * fade + 0.5
    let moved = t + rate / RATE
    if moved >= 1 {
        behind = ahead
        ahead = next
    }
    t = wrap(moved)
    return out
}
