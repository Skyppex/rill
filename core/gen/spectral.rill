// Images played as sound: a spectrogram read back, on the same grid
// `rill render -o song.png` draws one. The image's size is its resolution:
//
// - Every column is one step in time. The width is spread over `length`,
//   so 100 columns over 2s are 50 steps a second, and 2000 are 1000.
// - Every row is one sine, evenly spaced in pitch from `high` at the top to
//   `low` at the bottom; how bright it is says how loud. Play as many rows
//   as the image has for every one to count: `painted<FACE.height>(FACE,
//   2s)`.
//
// White is full level and black `range` below, as the renderer draws
// them, so a render read back with the same length, range and pitches
// plays at the level it was drawn at. No phase is kept: every sine just
// keeps running.

import @gen/osc

// How loud a brightness plays: white at full level, black `range` below,
// and 0 silent.
fn loudness(bright: Float, range: Gain) Float {
    if bright <= 0 { 0 } else { pow(amp(range), bright - 1) }
}

// The sine of row `row` of `rows`: `high` at the top, `low` at the bottom,
// evenly spaced in pitch between.
fn row_freq(row: Int, rows: Int, low: Freq, high: Freq) Freq {
    let along = if rows == 1 { 0.5 } else { row as Float / (rows - 1) as Float }
    high * pow(low / high, along)
}

// Where row `row` of `rows` reads `image`: the middle of its share of the
// height, which is the middle of a pixel when they are as many.
fn row_y(row: Int, rows: Int, image: Image) Float {
    (row as Float + 0.5) / rows as Float * image.height as Float
}

// The image in stereo: red is the left channel and blue the right (green is
// what a render found in both), so grey plays in the middle. With `mono`,
// the brightness of all three plays in both. The whole width lasts
// `length`, once or, with `loop`, over and over.
//
// Each column holds for its step, and moves to the next over `fade` (0s
// for hard steps, which click).
export rill painted<R>(
    image: Image,
    length: Time,
    low: Freq = 20Hz,
    high: Freq = 20kHz,
    range: Gain = 60dB,
    fade: Time = 2ms,
    mono: Bool = false,
    loop: Bool = false,
) [Sample; 2] {
    state t: Time = 0s
    let step = length / image.width as Float
    let at = t / step
    let column = floor(at)

    let blend = if fade <= 0s {
        1.0
    } else {
        min((at - column) * step / fade, 1.0)
    }

    let out: [[Sample; 2]; R]

    for row in 0..R {
        let y = row_y(row, R, image)
        // This column and the one before, at their centres; outside the
        // image they are black.
        let now = pixel(image, column + 0.5, y)
        let before = pixel(image, column - 0.5, y)
        let p = before + (now - before) * blend
        let mean = (p[0] + p[1] + p[2]) / 3
        let left = loudness(if mono { mean } else { p[0] }, range)
        let right = loudness(if mono { mean } else { p[2] }, range)
        let s = sine(row_freq(row, R, low, high))
        out[row] = [s * left, s * right]
    }

    t = t + 1 / RATE

    if loop && t >= length {
        t = t - length
    }

    return sum(out)
}

// The image as four channels: red, green, blue and alpha. Alpha is a mask
// in most images, and 1 everywhere in one without alpha, which plays as a
// full band: use it for images made to be heard.
export rill painted_rgba<R>(
    image: Image,
    length: Time,
    low: Freq = 20Hz,
    high: Freq = 20kHz,
    range: Gain = 60dB,
    fade: Time = 2ms,
    loop: Bool = false,
) [Sample; 4] {
    state t: Time = 0s
    let step = length / image.width as Float
    let at = t / step
    let column = floor(at)

    let blend = if fade <= 0s {
        1.0
    } else {
        min((at - column) * step / fade, 1.0)
    }

    let out: [[Sample; 4]; R]

    for row in 0..R {
        let y = row_y(row, R, image)
        let now = pixel(image, column + 0.5, y)
        let before = pixel(image, column - 0.5, y)
        let p = before + (now - before) * blend
        let s = sine(row_freq(row, R, low, high))

        out[row] = [
            s * loudness(p[0], range),
            s * loudness(p[1], range),
            s * loudness(p[2], range),
            s * loudness(p[3], range),
        ]
    }

    t = t + 1 / RATE

    if loop && t >= length {
        t = t - length
    }

    return sum(out)
}
