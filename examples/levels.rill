// Levels: a signal moves up or down with `+` or `-` and a level in dB.
// The level always comes after the signal.

rill sine(freq: Hz) -> sample {
    state phase: f32 = 0
    phase = wrap(phase + freq / RATE)
    return sin(phase * TAU)
}

// From `from` to `to` over `length`, then holds.
rill ramp(from: f32, to: f32, length: Time) -> f32 {
    state elapsed = 0s
    let t = min(elapsed / length, 1)
    if elapsed < length {
        elapsed = elapsed + 1 / RATE
    }
    return from + (to - from) * t
}

// `volume` is a live control. Hosts send it as a plain amplitude factor.
rill main(volume: Gain = -12dB) -> [sample; 2] {
    let voice = sine(220Hz)

    // Fade in evenly in level, from -60dB to 0dB over four seconds.
    let fade = ramp(-60, 0, 4s) * 1dB

    // The right channel sits 6dB below the left.
    let pair = [voice, voice - 6dB] + fade
    return pair + volume
}
