// A pad voice, built from the other files.

// The oscillators come from the core library, which every program has.
// `export import` passes on everything it exports: a file importing `synth`
// gets `saw` and `sine` too. `synth` can use them itself as well.
export import @gen/osc

// A plain import: only this file sees `lowpass`.
import ./fx

export const VOICES = 4

export rill pad(pitch: Freq) Sample {
    let detuned = saw(pitch) + saw(pitch * 1.003)
    return detuned * 0.5 |> lowpass()
}
