event press note_on
event release note_off

rill sine(freq: Freq) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    return sin(phase * TAU)
}

rill main() Sample {
    state pitch = A4
    state gain = 0.0
    // A tuning is just a fn from Pitch to Hz. `equal` takes the pitch first,
    // so this fills in the rest; named arguments are optional.
    let tuning = fn(p: Pitch) Freq { equal(p, 12, a4: 440Hz) }

    on press(note) {
        // note.pitch becomes this type of pitch instead of a frequency
        pitch = note.pitch
        // Velocity arrives as 0–1. Squaring it is a simple loudness curve:
        // a straight line sounds too loud at soft velocities.
        gain = note.velocity * note.velocity
    }

    on release(note) {
        gain = 0.0
    }

    return (pitch |> tuning |> sine) * gain
}
