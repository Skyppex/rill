// Polyphony: a chord is a frame of pitches, so every rill it passes through
// runs once per note. A stereo voice turns three notes into three stereo
// frames, and `sum` mixes them down to one.

import "@gen/osc"
import "@mix/stereo"

rill main(volume: Gain = -12dB) [Sample; 2] {
    let voices = [C4, E4, G4]
        |> just(C, 440Hz)
        // |> equal
        |> sine // [Sample; 3]

    // One position and one level per voice.
    let placed = voices
        |> pan([-0.6, 0, 0.6]) // [[Sample; 2]; 3]

    let shaped = placed + [0dB, -3dB, -6dB]

    return sum(shaped) + volume // [Sample; 2]
}
