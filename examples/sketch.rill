// The syntax sketch from design/design.md, filled in where it said `...`.

// Pure function on one value. Auto-lifted over streams and channels.

import "@gen/osc"
import "@effects/env"
import "@gen/noise"
import "@effects/filter"

fn abs(x: Sample) Sample {
    if x < 0 { -x } else { x }
}

// Stateful 1:1 rill. Body runs once per tick. Jumps up to the level of `x`
// and falls by 60 dB over `release`.
rill peak(x: Sample, release: Time = 300ms) Sample {
    return slew(abs(x), 0s, release)
}

// Composition with pipes.
rill meter(x: Sample) Sample {
    return x |> abs |> peak
}

// Generic over channel count. Only needed when a rill works ACROSS channels.
rill mix_down<N>(x: [Sample; N]) [Sample; 1] {
    return [sum(x) / N]
}

// Rate-changing rill: the ratio is part of the signature.
rill decimate(x: Sample) Sample @ rate / 2 {
    return x
}

// linear interpolation
fn lerp(a: Float, b: Float, t: Float) Float {
    return a + (b - a) * t
}

// interpolate linearly between two frames
rill wavetable(left: Sample, right: Sample, t: Float) Sample {
    return lerp(left, right, t)
}

rill ramp(from: Float, to: Float, time: Time) Float {
    state elapsed = 0s

    let t = min(elapsed / time, 1)

    if elapsed < time {
        elapsed = elapsed + 1 / RATE
    }

    return lerp(from, to, t)
}

rill crush(x: Sample, bits: Float = 8, hold: Time = 0.5ms) Sample {
    state held: Sample = 0
    state left: Time = 0s

    // Lower the sample rate: grab a new value every `hold`, repeat it in
    // between.
    if left <= 0s {
        held = x
        left = left + hold
    }

    left = left - 1 / RATE

    // Lower the bit depth: snap to 2^bits levels.
    let steps = pow(2, bits - 1)
    return round(held * steps) / steps
}

// Entry point: the program runs `main` and plays what it returns.
rill main() Sample {
    let lfo = perlin(1Hz)
    let voice1 = sine(440Hz)
    let voice2 = square(440Hz)

    let voice = wavetable(voice1, voice2, lfo) |> lowpass(2000Hz)

    return voice - 24dB
}
