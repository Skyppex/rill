// Channel lifting: `peak` takes one sample, so applied to a stereo frame it
// runs one independent copy per channel.

rill sine(freq: Freq) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    return sin(phase * TAU)
}

rill peak(x: Sample, release: Time = 300ms) Sample {
    state level: Sample = 0
    let a = abs(x)
    level = if a > level { a } else { level * decay(release) }
    return level
}

// Equal-power pan of a mono signal into a stereo frame.
fn pan(x: Sample, position: Float) [Sample; 2] {
    let angle = (position + 1) * PI / 4
    return [x * cos(angle), x * sin(angle)]
}

rill mix_down<N>(x: [Sample; N]) [Sample; 1] {
    return [sum(x) / N]
}

rill main() [Sample; 2] {
    let pair = [sine(220Hz), sine(330Hz)] * 0.25

    // One envelope follower per channel: `peak` is a rill, so it runs once
    // per channel of the frame.
    let env = pair |> peak(release: 50ms)

    let ducked = pair * (1 - env)
    return pan(mix_down(ducked)[0], -0.5)
}
