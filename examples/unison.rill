// Polyphony: a chord is a frame of pitches, so every rill it passes through
// runs once per note. A stereo voice turns three notes into three stereo
// frames, and `sum` mixes them down to one.

// `offset` starts the wave part of a cycle later (0 to 1), so copies at the
// same frequency need not move in step.
rill sine(freq: Freq, offset: Float = 0) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    return sin(wrap(phase + offset) * TAU)
}

// The correction a jump at phase 0 needs, to remove most of its aliasing
// (PolyBLEP). `dt` is how far the phase moves in one sample.
fn blep(t: Float, dt: Float) Float {
    if t < dt {
        let x = t / dt
        x + x - x * x - 1
    } else if t > 1 - dt {
        let x = (t - 1) / dt
        x * x + x + x + 1
    } else {
        0
    }
}

rill saw(freq: Freq, offset: Float = 0) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    let p = wrap(phase + offset)
    // One jump per cycle: down from 1 to -1 where `p` wraps.
    return p * 2 - 1 - blep(p, freq / RATE)
}

rill saw_no_blep(freq: Freq, phase_offset: Float = 0) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    return wrap(phase + phase_offset) * 2 - 1
}

rill square(freq: Freq, offset: Float = 0) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    let p = wrap(phase + offset)
    let dt = freq / RATE
    let naive = if p < 0.5 { 1.0 } else { -1.0 }
    // Two jumps per cycle: up at phase 0, down at phase 0.5.
    return naive + blep(p, dt) - blep(wrap(p + 0.5), dt)
}

rill bright(freq: Freq, phase_offset: Float = 0) Sample {
    state phase: Float = 0
    phase = wrap(phase + freq / RATE)
    let p = wrap(phase + phase_offset) * TAU

    return (
        (sin(p) + sin(p * 2) * 0.5 + sin(p * 3) * 0.33 + sin(p * 4) * 0.25)
        / 2.08
    )
}

// Equal-power panning: 0 is hard left, 1 hard right.
rill pan(x: Sample, pos: Float) [Sample; 2] {
    let angle = pos * PI / 2
    return [x * cos(angle), x * sin(angle)]
}

rill unison_pan<N>(voices: [Sample; N]) [[Sample; 2]; N] {
    let out: [[Sample; 2]; N]

    for i in 0..N {
        let pos = if N == 1 { 0.5 } else { i as Float / (N - 1) as Float }
        out[i] = pan(voices[i], pos)
    }

    return out
}

rill unison_bright<N>(pitches: [Freq; N]) [Sample; N] {
    let out: [Sample; N]

    for i in 0..N {
        let t = if N == 1 { 0.5 } else { i as Float / (N - 1) as Float }
        let phase_offset = wrap(i as Float * 0.61803398875)
        out[i] = bright(pitches[i], phase_offset) * (0.85 + 0.15 * sin(t * PI))
    }

    return out
}

rill unison<N>(pitch: Freq, spread: Interval) [Freq; N] {
    let pitches: [Freq; N]

    for i in 0..N {
        let t = if N == 1 { 0.5 } else { i as Float / (N - 1) as Float }

        let offset = spread * (t - 0.5)
        pitches[i] = pitch + offset
    }

    return pitches
}

rill lowpass(x: Sample, cutoff: Freq) Sample {
    state y = 0.0

    let alpha = 1.0 - exp(-2.0 * PI * cutoff / RATE)

    y += alpha * (x - y)

    return y
}

rill gain(x: Sample, gain: Gain) Sample {
    return x + gain
}

rill tremolo(
    x: Sample,
    speed: Freq,
    offset: Float = 0,
    depth: Float = 0.5,
) Sample {
    state phase: Float = 0
    phase = wrap(phase + speed / RATE)
    let lfo = sin(wrap(phase + offset) * TAU) * 0.5 + 0.5 // 0 to 1
    return x * (1 - depth * lfo)
}

rill main(volume: Gain = -12dB) [Sample; 2] {
    let chord1 = [C4, D#4, G4, A#4, D5]
    let chord2 = [G2, D3, B3, F4, A#4]
    let freqs = chord1 |> equal

    return (
        (
            unison<64>(freqs, 10cents)
                |> saw
                |> sum
                |> unison_pan
                |> sum
                |> tremolo(5Hz, depth: 0.4)
        )
            / 64
        + volume
    )
        |> lowpass(1000Hz)
}
